    "version": "0.2.0",
    "configurations": [
        {
            "name": "Android",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define-from-file=firebase_config.json"]
        },
        {
            "name": "Windows",
            "request": "launch",
            "type": "dart",
            "args": ["-d", "windows", "--dart-define-from-file=firebase_config.json"]
        },
        {
            "name": "Android (release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--dart-define-from-file=firebase_config.json"]
        },
        {
            "name": "Windows (release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["-d", "windows", "--dart-define-from-file=firebase_config.json"]
        }
    ]
}